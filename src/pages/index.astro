---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import classPhoto from '../assets/class-photo.jpg';

const VALUES = ['Reinforce', 'Ignite', 'Strengthen', 'Elevate'];

const KEYS = [
  { letter: 'R', word: 'Reinforce', src: '/images/keys/r.png' },
  { letter: 'I', word: 'Ignite', src: '/images/keys/i.png' },
  { letter: 'S', word: 'Strengthen', src: '/images/keys/s.png' },
  { letter: 'E', word: 'Elevate', src: '/images/keys/e.png' },
];

const LOREM =
  'lorem ipsum dolor sit amet consectetur adipiscing elit est occaecat tempor cumque voluptas aute omnis nobis quis ullamco magna distinctio aut cum officia mollitia iusto mollitia dolorem est sunt sed animi id consequat laboris amet do dolores eiusmod cupiditate eu aute qui';
---

<BaseLayout>
  <section class="relative overflow-hidden">
    <div class="grid-lines absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto flex min-h-[60vh] max-w-[1440px] flex-col items-center justify-center px-4 py-24 sm:min-h-[900px]">
      <img src="/icons/computer-blue.svg" alt="" width="68" height="75" class="animate-float absolute top-[18%] right-[10%] w-10 rotate-[12deg] sm:top-[24%] sm:right-[22%] sm:w-[88px]" style="animation-delay: -2s" />
      <img src="/icons/keyboard-blue.svg" alt="" width="93" height="93" class="animate-float-slow absolute top-[52%] left-[4%] w-14 sm:left-[10%] sm:w-24" style="animation-delay: -4.5s" />
      <h1 class="text-center leading-[0.85]">
        <span class="block text-[clamp(3rem,10vw,9.5rem)] font-normal" data-reveal="up" style="--reveal-delay: 80ms">Welcome to</span>{' '}
        <span class="text-script block pl-[10%] text-[clamp(3rem,10vw,9.5rem)]" data-reveal="up" style="--reveal-delay: 220ms">Rise Camp</span>
      </h1>
      <p class="mt-6 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-base italic sm:text-2xl" data-reveal="fade" style="--reveal-delay: 420ms">
        {VALUES.map((value, i) => (
          <>
            {i > 0 && <span aria-hidden="true" class="text-xs not-italic">◆</span>}
            <span>{value}</span>
          </>
        ))}
      </p>
    </div>
  </section>

  <section class="mx-auto grid max-w-[1440px] items-center gap-8 px-4 py-24 sm:px-14 md:grid-cols-2 md:gap-10 md:py-40">
    <Image
      src={classPhoto}
      alt="Foto bersama angkatan STEI-K '26"
      widths={[640, 1000, 1400]}
      sizes="(min-width: 768px) 50vw, 100vw"
      class="aspect-[704/430] w-full rounded-[40px] object-cover"
      data-reveal="left"
    />
    <div class="space-y-4" data-reveal="right" style="--reveal-delay: 120ms">
      <h2 class="text-5xl leading-none font-semibold sm:text-7xl">
        Hello! <span class="text-script font-normal">We are</span>
        <br />
        <span class="text-script font-normal">stei-k</span> <span class="font-normal">‘26!</span>
      </h2>
      <p class="text-lg font-light sm:text-2xl">{LOREM}</p>
    </div>
  </section>

  <section class="mx-auto max-w-[1440px] px-4 pb-16 text-center sm:px-16">
    <h2 class="text-4xl sm:text-7xl" data-reveal="up">
      The <span class="text-script px-2">philosophy</span> behind
    </h2>
    <ul class="mx-auto mt-8 grid max-w-5xl grid-cols-2 gap-6 sm:grid-cols-4 sm:gap-10" data-reveal-group>
      {KEYS.map(({ letter, word, src }) => (
        <li data-reveal="scale">
          <img src={src} alt={`${letter} — ${word}`} width="268" height="268" class="animate-float-slow mx-auto w-full max-w-[242px]" />
        </li>
      ))}
    </ul>
    <p class="mx-auto mt-10 max-w-6xl text-lg font-light sm:text-2xl" data-reveal="fade">{LOREM}</p>
  </section>
</BaseLayout>
