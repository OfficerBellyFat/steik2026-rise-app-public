---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, MATERI } from '../data/materi';

const INTRO =
  'lorem ipsum dolor sit amet consectetur adipiscing elit est occaecat tempor cumque voluptas aute omnis nobis quis ullamco magna distinctio aut cum officia mollitia iusto mollitia dolorem est sunt sed animi id consequat laboris amet do dolores eiusmod cupiditate eu aute qui';
---

<BaseLayout title="Materi" description="Kumpulan materi Rise Camp.">
  <section class="bg-linear-to-b from-tag-blue via-brand-tint to-white">
    <div class="mx-auto max-w-[1440px] px-4 pt-24 pb-12 sm:px-14 sm:pt-56">
      <h1 class="mx-auto w-fit leading-[0.85]">
        <span class="block text-[clamp(3.5rem,9vw,8.5rem)]" data-reveal="up" style="--reveal-delay: 60ms">Materi</span>{' '}
        <span class="text-script block pl-[30%] text-[clamp(3.5rem,9vw,8.5rem)]" data-reveal="up" style="--reveal-delay: 200ms">Rise Camp</span>
      </h1>
      <h2 class="mt-24 text-3xl font-semibold sm:mt-40 sm:text-5xl" data-reveal="up">Kumpulan materi</h2>
      <p class="mt-2 max-w-4xl font-light sm:text-xl" data-reveal="fade" style="--reveal-delay: 120ms">{INTRO}</p>
      <label class="relative mt-8 block" data-reveal="up" style="--reveal-delay: 200ms">
        <span class="sr-only">Cari materi</span>
        <input
          id="materi-search"
          type="search"
          placeholder="Cari materi Rise Camp"
          class="w-full rounded-full border border-neutral-200 bg-white px-8 py-5 text-center text-base placeholder:text-neutral-400 focus:border-brand focus:outline-none"
        />
        <svg class="pointer-events-none absolute top-1/2 right-6 size-5 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
        </svg>
      </label>
    </div>
  </section>

  <section class="mx-auto max-w-[1440px] px-4 pb-16 sm:px-14">
    <ul id="materi-list" class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-14 lg:gap-y-20" data-reveal-group>
      {MATERI.map((item) => {
        const category = CATEGORIES[item.category];
        const Tag = item.href ? 'a' : 'div';
        return (
          <li
            data-search={`${item.title} ${item.description} ${category.label}`.toLowerCase()}
            data-reveal="up"
          >
            <Tag
              {...(item.href ? { href: item.href, target: '_blank', rel: 'noopener noreferrer' } : {})}
              class:list={[
                'block h-full rounded-[2rem] border-2 border-neutral-200 p-8',
                item.href && 'transition hover:border-brand hover:shadow-lg',
              ]}
            >
              <span class:list={['inline-block rounded-full px-4 py-1 text-xs font-medium text-white', category.class]}>
                {category.label}
              </span>
              <h3 class="mt-2 text-2xl font-semibold sm:text-3xl">{item.title}</h3>
              <p class="mt-1 font-light text-neutral-700">{item.description}</p>
            </Tag>
          </li>
        );
      })}
    </ul>
    <p id="materi-empty" class="hidden py-12 text-center text-neutral-500">Materi tidak ditemukan.</p>
  </section>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('#materi-search')!;
  const items = document.querySelectorAll<HTMLLIElement>('#materi-list > li');
  const empty = document.querySelector<HTMLElement>('#materi-empty')!;

  input.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let visible = 0;
    items.forEach((item) => {
      const match = item.dataset.search!.includes(query);
      item.hidden = !match;
      if (match) visible++;
    });
    empty.classList.toggle('hidden', visible > 0);
  });
</script>
