---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROGRAMS } from '../data/programs';

const INTRO =
  "Temukan seluruh materi belajar yang kamu butuhkan dalam satu tempat. Pilih program yang sesuai dengan tujuanmu, lalu pelajari ringkasan konsep dan latihan soal secara bertahap.";
---

<BaseLayout title="Materi" description="Kumpulan materi Rise Camp.">
  <section class="bg-linear-to-b from-tag-blue via-brand-tint to-white">
    <div class="mx-auto max-w-[1440px] px-4 pt-24 pb-12 sm:px-14 sm:pt-56">
      <h1 class="mx-auto w-fit leading-[0.85]">
        <span class="block text-[clamp(3.5rem,9vw,8.5rem)]" data-reveal="up" style="--reveal-delay: 60ms">Materi</span>{' '}
        <span class="text-script block pl-[30%] text-[clamp(3.5rem,9vw,8.5rem)]" data-reveal="up" style="--reveal-delay: 200ms">Rise Camp</span>
      </h1>
      <h2 class="mt-24 text-3xl font-semibold sm:mt-40 sm:text-5xl" data-reveal="up">Kumpulan materi</h2>
      <p class="mt-2 max-w-4xl font-light sm:text-xl" data-reveal="fade" style="--reveal-delay: 120ms">{INTRO}</p>
    </div>
  </section>

  <section class="mx-auto max-w-[1440px] px-4 pb-16 sm:px-14">
    <ul class="grid gap-8 sm:grid-cols-2" data-reveal-group>
      {PROGRAMS.map((program) => (
        <li data-reveal="up">
          <a
            href={`/program/${program.id}`}
            class="flex h-full flex-col rounded-[2rem] border-2 border-neutral-200 p-8 transition hover:border-brand hover:shadow-lg"
          >
            <span class:list={['inline-block w-fit rounded-full px-4 py-1 text-xs font-medium text-white', program.labelClass]}>
              {program.title}
            </span>
            <h3 class="mt-2 text-2xl font-semibold sm:text-3xl">{program.tagline}</h3>
            <p class="mt-1 font-light text-neutral-700">{program.description}</p>
            <span class="mt-6 font-medium text-brand">Lihat materi →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
