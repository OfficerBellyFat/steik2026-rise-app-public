---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/format';
import { getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="prose prose-neutral mx-auto max-w-3xl px-4 py-16">
    <header class="not-prose mb-8" data-reveal="up">
      <h1 class="text-3xl font-bold tracking-tight">{post.data.title}</h1>
      <p class="mt-2 text-sm text-neutral-500">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.updatedDate && <> · Diperbarui {formatDate(post.data.updatedDate)}</>}
      </p>
    </header>
    <div data-reveal="fade" style="--reveal-delay: 150ms"><Content /></div>
  </article>
</BaseLayout>
