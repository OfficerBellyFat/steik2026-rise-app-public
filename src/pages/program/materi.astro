---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Placeholder from '../../components/Placeholder.astro';

const SECTIONS = [
  {
    id: 'tka',
    label: 'TKA',
    theme: 'bg-brand',
    icons: [
      { src: '/icons/flask-white.svg', w: 54, h: 67, pos: 'left-[-3.5rem] top-[3.25rem] -rotate-[12deg] sm:left-[-5rem] sm:top-[5.5rem]' },
      { src: '/icons/coin-search-white.svg', w: 63, h: 63, pos: 'right-[-3rem] top-[-1.5rem] sm:right-[-7rem] sm:top-[-2.5rem]' },
    ],
  },
  {
    id: 'utbk',
    label: 'UTBK',
    theme: 'bg-white',
    icons: [
      { src: '/icons/disc.svg', w: 67, h: 67, pos: 'right-[-3rem] top-[-2rem] sm:right-[-6rem] sm:top-[-3.5rem]' },
      { src: '/icons/pill.svg', w: 67, h: 67, pos: 'left-[-3.5rem] top-[3.25rem] -rotate-[12deg] sm:left-[-6rem] sm:top-[5rem]' },
    ],
  },
];
---

<BaseLayout title="Materi Program">
  <h1 class="sr-only">Materi Program Rise Camp</h1>
  {SECTIONS.map(({ id, label, theme, icons }, i) => (
    <>
      {i > 0 && (
        <div class="overflow-hidden bg-white" aria-hidden="true">
          <img src="/images/skyline-band.svg" alt="" width="1474" height="176" class="block h-auto w-[102.4%] max-w-none" />
        </div>
      )}
      <section id={id} class:list={['scroll-mt-4 px-4 py-16 sm:py-24', theme]} data-reveal="up">
        <h2 class="relative mx-auto w-fit font-pixel text-black">
          {icons.map((icon) => (
            <img src={icon.src} alt="" width={icon.w} height={icon.h} class:list={['animate-float absolute w-10 sm:w-[83px]', icon.pos]} style={{ animationDelay: `-${i * 3 + 1.5}s` }} />
          ))}
          <span class="block w-fit bg-yellow px-8 py-2 text-3xl shadow-hard sm:text-5xl">MATERI</span>{' '}
          <span class="relative -mt-3 ml-[40%] block w-fit bg-teal px-6 py-1 text-4xl shadow-hard sm:text-7xl">{label}</span>
        </h2>
        <!-- TODO: grey box in Figma; likely an embedded Drive folder or video -->
        <Placeholder label={`Konten materi ${label}`} class="mx-auto mt-16 aspect-[1107/472] max-w-[1107px]" />
      </section>
    </>
  ))}
</BaseLayout>
