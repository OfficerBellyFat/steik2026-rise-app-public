---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { PROGRAMS } from '../../data/programs';
---

<BaseLayout title="Program Kami">
  <section class="mx-auto max-w-[1440px] px-4 py-8 sm:px-10">
    <h1 class="font-pixel text-4xl sm:text-5xl" data-reveal="up">Program Rise Camp</h1>
    <div class="mt-6 space-y-16 sm:mt-8 sm:space-y-36" data-reveal-group>
      {PROGRAMS.map((program, i) => (
        <article class="overflow-hidden rounded-xl border border-brand-deep shadow-sm" data-reveal="up">
          <Image src={program.banner} alt={program.tagline} widths={[800, 1340, 2000]} sizes="(min-width: 1440px) 1340px, 100vw" loading={i === 0 ? 'eager' : 'lazy'} class="aspect-[1340/360] w-full object-cover" />
          <div class="grid gap-6 p-6 sm:p-8 md:grid-cols-[1fr_auto] md:items-end">
            <div>
              <h2
                class:list={[
                  'inline-block px-6 py-2 text-4xl font-semibold text-white shadow-hard sm:text-5xl lg:text-7xl',
                  program.labelClass,
                ]}
              >
                {program.title}
              </h2>
              <p class="mt-6 max-w-lg font-light sm:text-xl">{program.description}</p>
            </div>
            <a
              href={`/program/${program.id}`}
              class="rounded-xl border border-neutral-300 bg-neutral-100 px-16 py-5 text-center text-xl text-brand-deep shadow-md transition hover:bg-white sm:min-w-90 sm:text-2xl"
            >
              LANJUT
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
