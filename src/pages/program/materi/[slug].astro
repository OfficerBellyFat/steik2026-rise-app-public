---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Placeholder from '../../../components/Placeholder.astro';
import { MATERI_SECTIONS } from '../../../data/programs';

export function getStaticPaths() {
  return MATERI_SECTIONS.map((section) => ({
    params: { slug: section.slug },
    props: { section },
  }));
}

const { section } = Astro.props;
const { label, icons } = section;
---

<BaseLayout title={`Materi ${label}`}>
  <h1 class="sr-only">Materi Program {label} — Rise Camp</h1>
  <section class:list={['scroll-mt-4 px-4 py-16 sm:py-24 bg-white']} data-reveal="up">
    <h2 class="relative mx-auto w-fit font-pixel text-black">
      {icons.map((icon) => (
        <img
          src={icon.src}
          alt=""
          width={icon.w}
          height={icon.h}
          class:list={['animate-float absolute w-10 sm:w-[83px]', icon.pos]}
          style={{ animationDelay: '-1.5s' }}
        />
      ))}
      <span class="block w-fit bg-yellow px-8 py-2 text-3xl shadow-hard sm:text-5xl">MATERI</span>{' '}
      <span class="relative -mt-3 ml-[40%] block w-fit bg-teal px-6 py-1 text-4xl shadow-hard sm:text-7xl">{label}</span>
    </h2>
    <!-- TODO: grey box in Figma; likely an embedded Drive folder or video -->
    <Placeholder label={`Konten materi ${label}`} class="mx-auto mt-16 aspect-[1107/472] max-w-[1107px]" />
  </section>
</BaseLayout>
