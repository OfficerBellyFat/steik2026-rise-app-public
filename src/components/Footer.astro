---
import { Image } from 'astro:assets';
import { FOOTER_LINKS, SITE, SOCIAL } from '../consts';
import { SPONSORS } from '../data/sponsors';
---

<footer class="bg-linear-to-b from-white via-brand-tint to-brand/90">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-8 px-4 pt-32 pb-12 sm:flex-row sm:items-end sm:justify-between sm:px-24 sm:pt-48" data-reveal="fade">
    <div class="space-y-8" data-reveal="up">
      <p class="font-pixel text-4xl font-semibold leading-none sm:text-6xl">
        Connect
        <span class="text-script block pl-16 text-3xl font-normal sm:pl-28 sm:text-4xl">with us</span>
      </p>
      <ul class="flex flex-wrap items-center gap-4" data-reveal-group>
        {SPONSORS.map(({ name, logo, href }) => (
          <li class="flex h-16 items-center justify-center rounded-2xl bg-white px-5 ring-1 ring-neutral-200" data-reveal="up">
            {href ? (
              <a href={href} target="_blank" rel="noopener noreferrer">
                <Image src={logo} alt={name} class="max-h-8 w-auto object-contain" />
              </a>
            ) : (
              <Image src={logo} alt={name} class="max-h-8 w-auto object-contain" />
            )}
          </li>
        ))}
      </ul>
    </div>
    <div class="font-body space-y-2 text-sm sm:text-right sm:text-base" data-reveal="up" style="--reveal-delay: 120ms">
      <p>
        Instagram: <a href={SOCIAL.instagram.href} target="_blank" rel="noopener noreferrer" class="underline">{SOCIAL.instagram.handle}</a>
      </p>
      <ul class="flex gap-4 sm:justify-end">
        {FOOTER_LINKS.map(({ href, label }) => (
          <li><a href={href} class="hover:underline">{label}</a></li>
        ))}
      </ul>
      <p class="text-xs text-black/60">© {new Date().getFullYear()} {SITE.title}</p>
    </div>
  </div>
</footer>
