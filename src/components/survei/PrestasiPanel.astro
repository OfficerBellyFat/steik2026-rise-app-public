---
import { PRESTASI_SNBP } from '../../data/survei/prestasi';
---

<div class="space-y-10">
  <h2 class="text-2xl font-semibold sm:text-4xl">Prestasi Mahasiswa Jalur SNBP</h2>

  <ul class="columns-1 gap-6 md:columns-2 xl:columns-3">
    {PRESTASI_SNBP.map((items) => (
      <li class="mb-6 break-inside-avoid border-2 border-black bg-white p-5 shadow-hard-sm">
        <ul class="list-disc space-y-2 pl-5 font-body text-sm marker:text-brand wrap-anywhere">
          {items.map((a) => (
            <li>{a}</li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</div>
