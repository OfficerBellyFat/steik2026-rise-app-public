---
import { PRESTASI_SNBP, PRESTASI_SNBP_TANPA } from '../../data/survei/prestasi';
import RespondentCard from './RespondentCard.astro';

const total = PRESTASI_SNBP.length + PRESTASI_SNBP_TANPA;
---

<div class="space-y-10">
  <div class="grid gap-6 lg:grid-cols-3">
    <RespondentCard
      label="Responden Prestasi SNBP"
      count={total}
      description={`${PRESTASI_SNBP.length} mahasiswa mencantumkan setidaknya satu prestasi, sedangkan ${PRESTASI_SNBP_TANPA} lainnya menjawab tidak ada.`}
      footnote="Prestasi ditulis sendiri oleh responden dan hanya dirapikan seperlunya."
    />
    <div class="min-w-0 lg:col-span-2">
      <h2 class="text-2xl font-semibold sm:text-4xl">Prestasi Mahasiswa Jalur SNBP</h2>
      <p class="mt-2 max-w-3xl font-light text-neutral-700 sm:text-lg">
        Setiap kartu mewakili satu responden tanpa identitas. Daftar ini bisa jadi gambaran prestasi yang dimiliki pendaftar SNBP.
      </p>
    </div>
  </div>

  <ul class="columns-1 gap-6 md:columns-2 xl:columns-3">
    {PRESTASI_SNBP.map((items, i) => (
      <li class="mb-6 break-inside-avoid border-2 border-black bg-white p-5 shadow-hard-sm">
        <span class="inline-block bg-brand-tint px-2 py-0.5 text-xs font-semibold text-brand-deep">Responden {i + 1}</span>
        <ul class="mt-3 list-disc space-y-2 pl-5 font-body text-sm marker:text-brand wrap-anywhere">
          {items.map((a) => (
            <li>{a}</li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</div>
