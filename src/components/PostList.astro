---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/format';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{posts.length === 0 ? (
  <p class="text-neutral-600">Belum ada tulisan.</p>
) : (
  <ul class="divide-y divide-neutral-200" data-reveal-group>
    {posts.map((post) => (
      <li class="py-4" data-reveal="up">
        <a href={`/blog/${post.id}`} class="group block">
          <h3 class="font-medium group-hover:underline">
            {post.data.title}
            {post.data.draft && <span class="ml-2 rounded bg-amber-100 px-1.5 py-0.5 text-xs text-amber-800">Draf</span>}
          </h3>
          <p class="text-sm text-neutral-600">{post.data.description}</p>
          <time datetime={post.data.pubDate.toISOString()} class="text-xs text-neutral-500">
            {formatDate(post.data.pubDate)}
          </time>
        </a>
      </li>
    ))}
  </ul>
)}
